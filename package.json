{
  "name": "tank-wallet",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "metrics": "bun run scripts/metrics/index.ts",
    "audit:code": "bun run scripts/audit/code-audit.ts",
    "enforce": "bun run scripts/enforce/index.ts",
    "verify": "bun run scripts/verify/index.ts",
    "bench": "bun run scripts/bench/index.ts",
    "golden": "bun run scripts/golden-vectors/transaction-flow.ts",
    "test": "bun test src",
    "test:coverage": "bun test src --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
