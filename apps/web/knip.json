{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/{layout,page,error,global-error}.tsx",
    "src/app/api/**/route.ts",
    "src/instrumentation.ts",
    "src/proxy.ts",
    "scripts/**/*.ts",
    "src/components/wallet/**/*.tsx",
    "src/components/ui/**/*.tsx",
    "src/components/wallet/wallet-context.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/lib/wallet-engines/__tests__/**",
    "src/lib/wallet-kernel/__tests__/**",
    "src/lib/wallet-core/__tests__/**",
    "src/lib/wallet-plugins/**",
    "src/lib/wallet-translations/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**",
    "gsap-public/**",
    "public/**",
    "examples/**",
    "docs/**",
    "scripts/__tests__/**",
    "src/lib/observability/sentry.ts",
    "src/lib/observability/metrics.ts",
    "src/lib/observability/tracing.ts"
  ],
  "ignoreDependencies": [
    "@playwright/test",
    "@types/*",
    "bun-types",
    "eslint*",
    "tailwindcss*",
    "@tailwindcss/postcss",
    "tw-animate-css",
    "typescript",
    "next",
    "next-intl",
    "next-themes",
    "next-auth",
    "react",
    "react-dom",
    "viem",
    "bitcoinjs-lib",
    "ed25519-hd-key",
    "@sentry/nextjs",
    "@prisma/client",
    "@scure/bip32",
    "@scure/bip39",
    "@tanstack/react-query",
    "@tanstack/react-table",
    "zod",
    "@noble/curves",
    "@noble/ed25519",
    "@noble/hashes",
    "@opentelemetry/api",
    "@opentelemetry/exporter-trace-otlp-http",
    "@opentelemetry/resources",
    "@opentelemetry/sdk-node",
    "@opentelemetry/semantic-conventions",
    "prisma",
    "prom-client",
    "class-variance-authority",
    "clsx",
    "tailwind-merge",
    "lucide-react",
    "date-fns",
    "uuid",
    "framer-motion",
    "gsap",
    "recharts",
    "react-hook-form",
    "react-day-picker",
    "react-markdown",
    "react-syntax-highlighter",
    "react-resizable-panels",
    "sharp",
    "sonner",
    "vaul",
    "cmdk",
    "input-otp",
    "embla-carousel-react",
    "z-ai-web-dev-sdk",
    "zustand"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "exports": "warn",
    "types": "warn",
    "unlisted": "warn"
  }
}
