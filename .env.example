# TANK Wallet — .env.example
# Copie para .env (fora do git) e preencha. NUNCA versionar valores reais.

# --- Banco -----------------------------------------------------------------
# SQLite (desenvolvimento atual)
DATABASE_URL="file:./db/custom.db"
# Postgres (futuro / multi-tenant com RLS)
# DATABASE_URL="postgresql://USER:PASS@HOST:5432/tank_wallet?schema=public"

# --- Autenticação (next-auth) ---------------------------------------------
# Gerar: openssl rand -hex 32
NEXTAUTH_SECRET="change-me-generate-64-hex"
NEXTAUTH_URL="http://localhost:3000"

# --- Observabilidade -------------------------------------------------------
# Habilita Sentry quando o DSN está presente (docs/OBSERVABILITY.md)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# OpenTelemetry (OTLP) — deixa vazio para desligar
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_SERVICE_NAME="tank-wallet"

# --- Segurança / API -------------------------------------------------------
# Proxy GoPlus / RDAP / Threat Intel (se distintos)
GOPLUS_PROXY_KEY=""
API_RATE_LIMIT_PER_MIN="120"

# Bot-management / WAF (docs/SECURITY-GATE.md)
BOT_MODE="monitor"   # monitor | block

# --- WalletConnect ---------------------------------------------------------
WALLETCONNECT_PROJECT_ID=""   # https://cloud.walletconnect.com

# --- Broadcast / Indexer ---------------------------------------------------
ALCHEMY_API_KEY=""
INFURA_API_KEY=""
